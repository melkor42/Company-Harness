{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company-harness.local/schema/process-definition",
  "title": "Prozessdefinition",
  "description": "Versionierte Datei, kein Prompt-Fragment. Was nicht in allowed_actions steht, ist unmöglich.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "version", "synthetisch", "trigger", "required_evidence",
    "allowed_actions", "checkpoints", "abort_conditions", "escalation"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-zäöüß0-9]+(-[a-zäöüß0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "synthetisch": { "const": true },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["art", "erwartet"],
      "properties": {
        "art": { "enum": ["eingang", "meldung", "termin"] },
        "erwartet": { "type": "string", "minLength": 1 }
      }
    },
    "required_evidence": {
      "type": "array", "minItems": 1,
      "items": { "enum": ["agreement", "capacity", "rule", "acceptance", "commitment", "fact"] }
    },
    "allowed_actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "requires_approval"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zäöüß0-9]+(-[a-zäöüß0-9]+)*$" },
          "requires_approval": { "type": "boolean" },
          "target": { "type": "string", "description": "Schreibziel unter prototype/sandbox-systems/." }
        }
      }
    },
    "checkpoints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "abort_conditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "escalation": { "type": "string", "pattern": "^(rolle|person):[^ ]+$" }
  }
}
